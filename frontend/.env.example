# Frontend Environment Variables Example
# Copy this file to .env.local and fill in your actual values
# Vite uses .env.local for local overrides. 
# Do NOT commit .env or .env.local to GitHub if they contain secrets.

# Backend API URL
# Local development
# VITE_API_URL=http://localhost:5000/api

# Production (e.g., Railway/Heroku/Vercel backend URL)
VITE_API_URL=https://your-production-backend.railway.app/api
