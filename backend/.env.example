# Backend Environment Variables Example
# Copy this file to .env and fill in your actual secrets
# DO NOT COMMIT .env TO GITHUB

# Server Configuration
PORT=5000
NODE_ENV=development
# Use 'production' for live server
# FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/forex-signals?retryWrites=true&w=majority

# Authentication
# Generate a strong random string for JWT_SECRET (e.g., using openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# M-Pesa Integration (Daraja API)
# Get these from Safaricom Developer Portal: https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
# Set to 'production' for live payments, or 'sandbox' for testing
MPESA_ENVIRONMENT=sandbox

# Backend URL for Callbacks
# In production, this must be your live backend URL (e.g., https://your-app.railway.app)
BACKEND_URL=http://localhost:5000
